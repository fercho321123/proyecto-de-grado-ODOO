<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_pyme_devoluciones" model="ir.module.category">
            <field name="name">Devoluciones Hamburguesería</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_devolucion_user" model="res.groups">
            <field name="name">Usuario de Devoluciones</field>
            <field name="category_id" ref="module_category_pyme_devoluciones"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_pyme_devolucion_all" model="ir.rule">
            <field name="name">Ver todas las devoluciones</field>
            <field name="model_id" ref="model_pyme_devolucion"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>